# Both are OPTIONAL for local development.
#
# Left unset, the app derives the backend from the address the page was opened
# on (see src/config.js), so http://localhost:5173 and http://<your-lan-ip>:5173
# both work with no configuration.
#
# Set them when the API lives somewhere else — i.e. a real deployment:
#   VITE_API_BASE_URL=https://collabboard-backend.onrender.com
#   VITE_WS_URL=https://collabboard-backend.onrender.com/ws
#
# Vite inlines these at BUILD time, so you must rebuild/redeploy after changing
# them — restarting is not enough.

# VITE_API_BASE_URL=
# VITE_WS_URL=

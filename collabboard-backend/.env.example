# Copy to .env and adjust. None of these are needed for the `dev` profile,
# which uses an in-memory database.

# --- Database: either the three DB_* values, or one DATABASE_URL -------------
DB_URL=jdbc:postgresql://localhost:5432/collabboard
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Platform-style alternative (Render, Railway, Heroku inject this for you):
# DATABASE_URL=postgresql://user:password@host:5432/collabboard

# --- Server ------------------------------------------------------------------
PORT=8080
# Exact origin(s) of the frontend, comma-separated. "*" allows any site.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional ----------------------------------------------------------------
# Delete rooms with no activity for this many days (0 = keep forever).
# ROOM_RETENTION_DAYS=30
# Rooms one address may create per minute (0 = unlimited).
# ROOM_CREATIONS_PER_MINUTE=20
# Maximum database connections.
# DB_POOL_SIZE=5
